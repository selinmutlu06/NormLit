# Supabase (required — use NEXT_PUBLIC_ prefix for the Next.js app)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Legacy names also supported by the app:
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# OpenAI — required for PDF embeddings / semantic search
OPENAI_API_KEY=your_openai_api_key

# Anthropic — recommended for chat & compare (Claude Opus 4.7)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional: force OpenAI for chat instead of Claude
# CHAT_MODEL=openai
